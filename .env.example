# amoCRM API
AMOCRM_DOMAIN=rightwaykpg.amocrm.ru
AMOCRM_TOKEN=

# amoCRM catalog with objects
AMOCRM_OBJECTS_CATALOG_ID=9077

# amoCRM pipelines (for form routing)
AMOCRM_PIPELINE_LAND=7508490
AMOCRM_PIPELINE_VILLA_HOUSE=10966398

# Public site URL (set in Vercel for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram deep-link
NEXT_PUBLIC_TELEGRAM_BOT=rightwayphangan_bot
NEXT_PUBLIC_TELEGRAM_CHANNEL=rightwayphangan

# Contact
NEXT_PUBLIC_WHATSAPP_E164=66843627784

# Telegram notification on new website lead (optional — leave empty to disable)
# Get a bot token from @BotFather, then get your chat_id by DMing @userinfobot
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Admin object intake (/admin/new) — HTTP Basic Auth. Fails closed if unset:
# /admin/* is inaccessible until both are provided (also set them in Vercel).
ADMIN_USER=
ADMIN_PASSWORD=

# Vercel Blob — photo uploads from the admin form (auto-set on Vercel; for
# local dev pull it via `vercel env pull` or paste the read-write token).
BLOB_READ_WRITE_TOKEN=

# Claude vision — auto-routes uploaded document-scans/maps/sheets to DOCS
# (non-public) instead of public PHOTOS. Optional: when empty the form falls
# back to the manual "это документ" toggle. See src/lib/classify/image-doc.ts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Tag Manager — single container dispatching GA4 / Meta Pixel / Google Ads.
# Ships dark until set: with no value the GTM scripts are not rendered and the
# dataLayer events (lead_submit / *_click / view_listing / roi_complete) just
# queue harmlessly. Set in Vercel to go live. Meta Pixel + GA4 ids are configured
# inside GTM, not here. See docs/marketing playbook "Приложение A".
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# PostHog — product analytics (funnels, session replay, heatmaps), init in
# src/instrumentation-client.ts. Ships dark like GTM: with no key nothing loads
# and no event is sent. Project token is public by design (it ships in the page
# on any PostHog site); take it from Project settings → "Project API key".
# Host: https://us.i.posthog.com or https://eu.i.posthog.com — must match the
# region picked when the project was created, otherwise events land nowhere.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Plausible / Vercel Analytics (later)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
